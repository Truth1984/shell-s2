}

#heavy
u_cmd_q() {
  local a
  for a in "$@"; do
    case "$a" in -h|--help) u_usage q; return 0 ;; esac
  done
  u_ensure_dirs
  case "${1:-}" in
    "")
      local f name first
      for f in "$U_QUICK"/*; do
        [ -f "$f" ] || continue
        name=${f##*/}
        first=$(grep -m1 -v -e '^#' -e '^$' "$f" 2>/dev/null)
        printf '%s\t%s\n' "$name" "$first"
      done
      ;;
    ls|list)
      shift
      local f name first
      for f in "$U_QUICK"/*; do
        [ -f "$f" ] || continue
        name=${f##*/}
        first=$(grep -m1 -v -e '^#' -e '^$' "$f" 2>/dev/null)
        printf '%s\t%s\n' "$name" "$first"
      done
      ;;
    add)
      shift
      local name=${1:-}
      [ -n "$name" ] || u_die 2 "usage: u q add <name> [command...]"
      u_valid_name "$name" || u_die 2 "invalid quick name: $name"
      shift || true
      local file cmd=""
      file=$(u_quick_file "$name")
      if [ "$#" -gt 0 ]; then
        cmd="$*"
      elif [ ! -t 0 ]; then
        cmd=$(cat)
      fi
      {
        printf '#!/usr/bin/env bash\n'
        printf '# u quick: %s\n' "$name"
        [ -n "$cmd" ] && printf '%s\n' "$cmd"
      } >"$file" || u_die 4 "cannot write: $file"
      chmod 755 "$file"
      if [ -z "$cmd" ] && [ -t 0 ]; then
        u_edit_file "$file"
      fi
      printf '%s\n' "$file"
      ;;
    run)
      shift
      local name=${1:-}
      [ -n "$name" ] || u_die 2 "usage: u q run <name> [args...]"
      shift || true
      local file
      file=$(u_quick_file "$name")
      [ -f "$file" ] || u_die 1 "no quick command: $name"
      bash "$file" "$@"
      ;;
    cat|show)
      shift
      local name=${1:-}
      [ -n "$name" ] || u_die 2 "usage: u q cat <name>"
      local file
      file=$(u_quick_file "$name")
      [ -f "$file" ] || u_die 1 "no quick command: $name"
      cat "$file"
      ;;
    edit)
      shift
      local name=${1:-}
      [ -n "$name" ] || u_die 2 "usage: u q edit <name>"
      local file
      file=$(u_quick_file "$name")
      [ -f "$file" ] || u_die 1 "no quick command: $name"
      u_edit_file "$file"
      ;;
    path)
      shift
      local name=${1:-}
      [ -n "$name" ] || u_die 2 "usage: u q path <name>"
      u_quick_file "$name"
      ;;
    rm|remove)
      shift
      local name=${1:-}
      [ -n "$name" ] || u_die 2 "usage: u q rm <name>"
      local file
      file=$(u_quick_file "$name")
      [ -f "$file" ] || u_die 1 "no quick command: $name"
      u_trash_put "$file"
      ;;
    -*)
      u_die 2 "usage: u q [<name> [args...]] | ls | add | run | cat | edit | path | rm"
      ;;
    *)
      local name=$1
      shift || true
      local file
      file=$(u_quick_file "$name")
      [ -f "$file" ] || u_die 1 "no quick command: $name"
      bash "$file" "$@"
      ;;
  esac
}

#heavy
u_cmd_clone() {
  local ssh=0 dir="${U_CLONE_DIR:-$HOME/Documents}" target="" a
  while [ "$#" -gt 0 ]; do
    a=$1
    case "$a" in
      --ssh) ssh=1 ;;
      --dir)
        shift
        dir=${1:-}
        [ -n "$dir" ] || u_die 2 "--dir needs a directory"
        ;;
      -*) u_die 2 "unknown option: $a" ;;
      *) target=$a ;;
    esac
    shift
  done
  [ -n "$target" ] || u_die 2 "usage: u clone [--ssh] [--dir DIR] <owner/repo|url>"
  dir=$(u_expand "$dir")
  u_need_cmd git
  local url name dest
  case "$target" in
    http*|git@*|ssh://*|*://*)
      url=$target
      ;;
    */*)
      case "$target" in
        *.git) ;;
        *) target="$target.git" ;;
      esac
      if [ "$ssh" = 1 ]; then
        url="git@github.com:${target}"
      else
        url="https://github.com/${target}"
      fi
      ;;
    *)
      local user=${U_GIT_USER:-}
      if [ -z "$user" ]; then
        if [ -t 0 ]; then
          user=$(u_prompt "GitHub user for $target:")
        fi
        [ -n "$user" ] || u_die 2 "pass owner/repo or set U_GIT_USER"
      fi
      if [ "$ssh" = 1 ]; then
        url="git@github.com:${user}/${target}.git"
      else
        url="https://github.com/${user}/${target}.git"
      fi
      ;;
  esac
  name=${target##*/}
  name=${name%.git}
  dest="$dir/$name"
  [ -e "$dest" ] && u_die 5 "destination already exists: $dest"
  mkdir -p "$dir" || u_die 4 "cannot create: $dir"
  git clone "$url" "$dest" || u_die 1 "clone failed: $url"
  printf '%s\n' "$dest"
}

#heavy
u_cmd_g() {
  local a
  for a in "$@"; do
    case "$a" in -h|--help) u_usage g; return 0 ;; esac
  done
  u_scan_yes "$@"
  u_need_cmd git
  local sub=${1:-}
  case "$sub" in
    ""|log)
      shift || true
      local n=${1:-30}
      case "$n" in *[!0-9]*) u_die 2 "count must be a number: $n" ;; esac
      git log --all --decorate --oneline --graph -n "$n"
      ;;
    st|status)
      git status -sb
      ;;
    co|checkout)
      shift
      [ "$#" -ge 1 ] || u_die 2 "usage: u g co <ref>"
      git checkout "$1"
      ;;
    reset)
      shift
      [ "$#" -ge 1 ] || u_die 2 "usage: u g reset <ref> [--yes]"
      local ref=$1
      u_confirm "hard reset $PWD to $ref?" || return 1
      git reset --hard "$ref"
      ;;
    branches|br)
      git branch -vv
      ;;
    *)
      u_die 2 "usage: u g [log [n]] [st] [co <ref>] [reset <ref>] [branches]"
      ;;
  esac
}

u_dk_names() {
  command docker ps -a --format '{{.Names}}' 2>/dev/null
}

u_dk_image_names() {
  command docker images --format '{{.Repository}}:{{.Tag}}' 2>/dev/null
}

u_dk_pick() {
  local q=$1 names=$2 n exact="" matches="" count=0 old_ifs
  [ -n "$names" ] || return 1
  old_ifs=$IFS
  IFS=$'\n'
  for n in $names; do
    if [ "$n" = "$q" ]; then
      exact=$n
      break
    fi
  done
  if [ -n "$exact" ]; then
    IFS=$old_ifs
    printf '%s\n' "$exact"
    return 0
  fi
  for n in $names; do
    case "$n" in
      "$q"*)
        matches="${matches}${n}"$'\n'
        count=$((count + 1))
        ;;
    esac
  done
  IFS=$old_ifs
  if [ "$count" -eq 1 ]; then
    printf '%s\n' "${matches%$'\n'}"
    return 0
  fi
  if [ "$count" -gt 1 ]; then
    u_err "ambiguous name: $q"
    printf '%s' "$matches" >&2
  fi
  return 1
}

#heavy
u_cmd_dk() {
  u_scan_yes "$@"
  u_need_cmd docker
  local sub=${1:-}
  case "$sub" in
    ""|ps)
      command docker ps -a
      ;;
    images)
      command docker images
      ;;
    stats)
      command docker stats --no-stream
      ;;
    inspect)
      shift
      [ "$#" -ge 1 ] || u_die 2 "usage: u dk inspect <name>"
      local name
      name=$(u_dk_pick "$1" "$(u_dk_names)") || name=$1
      command docker inspect "$name"
      ;;
    logs)
      shift
      [ "$#" -ge 1 ] || u_die 2 "usage: u dk logs <name> [-f]"
      local name follow=0
      name=$(u_dk_pick "$1" "$(u_dk_names)") || u_die 1 "container not found: $1"
      shift
      case "${1:-}" in -f|--follow) follow=1 ;; esac
      if [ "$follow" = 1 ]; then
        command docker logs -f --tail 500 "$name"
      else
        command docker logs --tail 500 "$name"
      fi
      ;;
    sh|shell|exec)
      shift
      [ "$#" -ge 1 ] || u_die 2 "usage: u dk sh <name>"
      local name
      name=$(u_dk_pick "$1" "$(u_dk_names)") || u_die 1 "container not found: $1"
      command docker exec -it "$name" sh -c '[ -x /bin/bash ] && exec /bin/bash || exec /bin/sh'
      ;;
    run)
      shift
      [ "$#" -ge 1 ] || u_die 2 "usage: u dk run <image> [command...]"
      local image=$1
      shift
      if [ "$#" -gt 0 ]; then
        command docker run --rm -it "$image" "$@"
      else
        command docker run --rm -it --entrypoint sh "$image" -c '[ -x /bin/bash ] && exec /bin/bash || exec /bin/sh'
      fi
      ;;
    stop)
      shift
      [ "$#" -ge 1 ] || u_die 2 "usage: u dk stop <name>"
      local name
      name=$(u_dk_pick "$1" "$(u_dk_names)") || u_die 1 "container not found: $1"
      command docker stop "$name"
      ;;
    rm|remove)
      shift
      [ "$#" -ge 1 ] || u_die 2 "usage: u dk rm <name>"
      local name
      name=$(u_dk_pick "$1" "$(u_dk_names)") || u_die 1 "container not found: $1"
      command docker rm "$name"
      ;;
    save)
      shift
      [ "$#" -ge 1 ] || u_die 2 "usage: u dk save <name> [file]"
      local image file
      image=$(u_dk_pick "$1" "$(u_dk_image_names)") || u_die 1 "image not found: $1"
      file=${2:-}
      [ -n "$file" ] || file=$(printf '%s' "$image" | sed 's|/|-|g; s|:|-|g').tar
      command docker save -o "$file" "$image" && printf '%s\n' "$file"
      ;;
    load)
      shift
      [ "$#" -ge 1 ] || u_die 2 "usage: u dk load <file>"
      [ -f "$1" ] || u_die 1 "not found: $1"
      command docker load -i "$1"
      ;;
    clean)
      u_confirm "remove unused docker data?" || return 1
      command docker system prune -f
      ;;
    *)
      u_die 2 "usage: u dk [ps|images|stats|inspect|logs|sh|run|stop|rm|save|load|clean]"
      ;;
  esac
}

u_compose() {
  if command docker compose version >/dev/null 2>&1; then
    command docker compose "$@"
  elif u_has_cmd docker-compose; then
    docker-compose "$@"
  else
    u_die 3 "docker compose is not available"
  fi
}

u_compose_file() {
  [ -n "${COMPOSE_FILE:-}" ] && return 0
  local f
  for f in docker-compose.yml docker-compose.yaml compose.yml compose.yaml; do
    [ -f "$f" ] && return 0
  done
  return 1
}

u_compose_services() {
  u_compose ps --services 2>/dev/null
}

u_compose_pick() {
  local q=$1 services
  services=$(u_compose_services)
  [ -n "$services" ] || return 1
  u_dk_pick "$q" "$services"
}

#heavy
u_cmd_dc() {
  u_need_cmd docker
  local sub=${1:-}
  case "$sub" in
    up)
      u_compose_file || u_die 3 "no compose file in $PWD"
      if [ -f .env ]; then
        u_compose --env-file .env up -d
      else
        u_compose up -d
      fi
      ;;
    down)
      u_compose_file || u_die 3 "no compose file in $PWD"
      u_compose down --remove-orphans
      ;;
    ps|status)
      u_compose_file || u_die 3 "no compose file in $PWD"
      u_compose ps -a
      ;;
    logs)
      u_compose_file || u_die 3 "no compose file in $PWD"
      shift
      local svc="" follow=0 a
      for a in "$@"; do
        case "$a" in
          -f|--follow) follow=1 ;;
          -*) u_die 2 "unknown option: $a" ;;
          *) svc=$a ;;
        esac
      done
      local -a cmd=(logs --tail 500)
      [ "$follow" = 1 ] && cmd+=(-f)
      [ -n "$svc" ] && cmd+=("$svc")
      u_compose "${cmd[@]}"
      ;;
    sh|shell)
      u_compose_file || u_die 3 "no compose file in $PWD"
      shift
      local svc=${1:-}
      if [ -z "$svc" ]; then
        svc=$(u_compose_pick "" ) || u_die 2 "no running service; pass a service name"
      fi
      u_compose exec -it "$svc" sh -c '[ -x /bin/bash ] && exec /bin/bash || exec /bin/sh'
      ;;
    exec)
      u_compose_file || u_die 3 "no compose file in $PWD"
      shift
      [ "$#" -ge 2 ] || u_die 2 "usage: u dc exec <service> <command...>"
      local svc=$1
      shift
      u_compose exec "$svc" "$@"
      ;;
    build)
      u_compose_file || u_die 3 "no compose file in $PWD"
      shift
      local nocache=0
      case "${1:-}" in --no-cache) nocache=1 ;; esac
      if [ "$nocache" = 1 ]; then
        u_compose build --no-cache --progress plain
      else
        u_compose build --progress plain
      fi
      ;;
    restart)
      u_compose_file || u_die 3 "no compose file in $PWD"
      shift
      if [ "$#" -ge 1 ]; then
        u_compose restart "$1"
      else
        u_compose restart
      fi
      ;;
    stop)
      u_compose_file || u_die 3 "no compose file in $PWD"
      u_compose stop
      ;;
    images)
      u_compose_file || u_die 3 "no compose file in $PWD"
      u_compose images
      ;;
    *)
      u_die 2 "usage: u dc [up|down|ps|logs|sh|exec|build|restart|stop|images]"
      ;;
  esac
}

u_svc_kind() {
  if u_has_cmd systemctl; then
    printf 'systemd\n'
  elif u_has_cmd rc-service; then
    printf 'openrc\n'
  elif u_has_cmd launchctl; then
    printf 'launchctl\n'
  elif u_has_cmd sc.exe; then
    printf 'sc\n'
  else
    printf 'none\n'
  fi
}

u_svc_names() {
  local kind=$1
  case "$kind" in
    systemd) systemctl list-units --type=service --no-legend --no-pager 2>/dev/null | awk '{ print $1 }' ;;
    openrc) rc-status --servicelist 2>/dev/null | awk '{ print $1 }' ;;
    launchctl) launchctl list 2>/dev/null | awk 'NR > 1 { print $3 }' ;;
    sc) sc.exe query state= all 2>/dev/null | tr -d '\r' | awk '/SERVICE_NAME/{ print $2 }' ;;
  esac
}

u_svc_resolve() {
  local kind=$1 q=$2 names
  names=$(u_svc_names "$kind")
  [ -n "$names" ] || return 1
  u_dk_pick "$q" "$names"
}

#heavy
u_cmd_svc() {
  local kind sub name
  kind=$(u_svc_kind)
  [ "$kind" != none ] || u_die 3 "no supported service manager found"
  sub=${1:-}
  case "$sub" in
    ""|ls|list)
      u_svc_names "$kind"
      ;;
    status)
      shift
      [ "$#" -ge 1 ] || u_die 2 "usage: u svc status <name>"
      name=$1
      case "$kind" in
        systemd) systemctl status --no-pager "$name" ;;
        openrc) rc-service "$name" status ;;
        launchctl) launchctl list | grep -F "$name" ;;
        sc) sc.exe query "$name" ;;
      esac
      ;;
    start|stop|restart|enable|disable)
      shift
      [ "$#" -ge 1 ] || u_die 2 "usage: u svc $sub <name>"
      name=$(u_svc_resolve "$kind" "$1") || name=$1
      case "$kind" in
        systemd)
          case "$sub" in
            start|stop|restart)
              u_root systemctl "$sub" "$name"
              ;;
            enable) u_root systemctl enable "$name" ;;
            disable) u_root systemctl disable "$name" ;;
          esac
          ;;
        openrc)
          case "$sub" in
            start|stop|restart) u_root rc-service "$name" "$sub" ;;
            enable) u_root rc-update add "$name" default ;;
            disable) u_root rc-update del "$name" default ;;
          esac
          ;;
        launchctl)
          u_die 3 "launchctl start/stop is not implemented; use launchctl directly"
          ;;
        sc)
          case "$sub" in
            start) u_root sc.exe start "$name" ;;
            stop) u_root sc.exe stop "$name" ;;
            restart)
              u_root sc.exe stop "$name"
              u_root sc.exe start "$name"
              ;;
            enable) u_root sc.exe config "$name" start= auto ;;
            disable) u_root sc.exe config "$name" start= disabled ;;
          esac
          ;;
      esac
      ;;
    *)
      u_die 2 "usage: u svc [ls|status|start|stop|restart|enable|disable] [name]"
      ;;
  esac
}

#heavy
u_cmd_open() {
  local app="" target=""
  case "${1:-}" in
    --app)
      shift
      app=${1:-}
      [ -n "$app" ] || u_die 2 "--app needs a name"
      ;;
    *)
      target=${1:-}
      ;;
  esac
  if [ -n "$app" ]; then
    [ "$U_OS" = mac ] || u_die 3 "--app is macOS only"
    open -a "$app" 2>/dev/null || u_die 1 "no application matches: $app"
    return 0
  fi
  [ -n "$target" ] || u_die 2 "usage: u open <path|url>"
  case "$target" in
    http://*|https://*|mailto:*)
      ;;
    *)
      [ -e "$target" ] || u_die 1 "not found: $target"
      target=$(u_abs "$target")
      ;;
  esac
  case "$U_OS" in
    mac) open "$target" ;;
    linux) u_need_cmd xdg-open; xdg-open "$target" >/dev/null 2>&1 & ;;
    windows) cmd.exe //c start "" "$target" ;;
    *) u_die 3 "unsupported platform" ;;
  esac
}

u_cmd_edit() {
  local file=${1:-$U_SELF}
  [ -f "$file" ] || u_die 1 "not found: $file"
  u_edit_file "$file"
}

u_cmd_log() {
  local lines=1000 file="" msg="" a
  while [ "$#" -gt 0 ]; do
    a=$1
    case "$a" in
      --lines|-n)
        shift
        lines=${1:-}
        case "$lines" in ''|*[!0-9]*) u_die 2 "--lines needs a number" ;; esac
        [ "$lines" -ge 1 ] || u_die 2 "--lines must be at least 1"
        ;;
      -*)
        u_die 2 "unknown option: $a"
        ;;
      *)
        if [ -z "$file" ]; then
          file=$a
        else
          msg="$msg $a"
        fi
        ;;
    esac
    shift
  done
  [ -n "$file" ] || u_die 2 "usage: u log [--lines N] <file> <message...>"
  local dir
  dir=$(dirname "$file")
  [ -d "$dir" ] || u_die 1 "directory not found: $dir"
  printf '%s\t%s\n' "$(u_now_iso)" "${msg# }" >>"$file"
  local count
  count=$(wc -l <"$file" | tr -d ' ')
  if [ "$count" -gt "$lines" ]; then
    local half=$((lines / 2)) tmp
    [ "$half" -lt 1 ] && half=1
    tmp="$file.$$.tmp"
    tail -n "$half" "$file" >"$tmp" && mv "$tmp" "$file"
  fi
}

# --- debug helpers ---------------------------------------------------------
u_cmd__path() {
  printf '%s\n' "$U_SELF_DIR"
}

u_cmd__file() {
  printf '%s\n' "$U_SELF"
}

u_cmd__catalog() {
  u_catalog
}

u_cmd__selftest() {
  local fails=0 checks=0
  chk() {
    local label=$1
    shift
    checks=$((checks + 1))
    if "$@"; then
      return 0
    fi
    printf 'FAIL: %s\n' "$label" >&2
    fails=$((fails + 1))
    return 0
  }
  chk "epoch 0" test "$(u_epoch 0)" = 0
  chk "format epoch" test "$(TZ=UTC u_fmt_epoch 0 '%Y-%m-%d')" = "1970-01-01"
  chk "str eq" u_cmd_str eq a a
  chk "str eq differs" eval '! u_cmd_str eq a b'
  chk "str contains" u_cmd_str contains "hello world" "lo wo"
  chk "has sh" u_has_cmd sh
  chk "valid name" u_valid_name "abc-1.2"
  chk "invalid name" eval '! u_valid_name "a/b"'
  chk "valid env" u_valid_env_name "HOME"
  chk "invalid env" eval '! u_valid_env_name "1BAD"'

  local names n fn
  names=$(u_catalog | cut -d'|' -f1)
  for n in $names; do
    checks=$((checks + 1))
    if ! u_usage "$n" >/dev/null 2>&1; then
      printf 'FAIL: usage for %s\n' "$n" >&2
      fails=$((fails + 1))
    fi
    checks=$((checks + 1))
    fn="u_cmd_${n//-/_}"
    if ! command -v "$fn" >/dev/null 2>&1; then
      printf 'FAIL: dispatch for %s (missing %s)\n' "$n" "$fn" >&2
      fails=$((fails + 1))
    fi
  done

  if [ "$fails" -eq 0 ]; then
    printf 'ok: %s checks\n' "$checks"
    return 0
  fi
  printf '%s of %s checks failed\n' "$fails" "$checks" >&2
  return 1
}

# --- dispatch --------------------------------------------------------------
u_main() {
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --debug) U_DEBUG=1; shift ;;
      --json) U_JSON=1; shift ;;
      --yes|-y) U_YES=1; shift ;;
      --)
        shift
        break
        ;;
      -h|--help)
        u_help
        return 0
        ;;
      -V|--version)
        u_cmd_version
        return 0
        ;;
      -*)
        u_die 2 "unknown global option: $1 (see: u help)"
        ;;
      *)
        break
        ;;
    esac
  done

  if [ "$#" -eq 0 ]; then
    u_help
    return 0
  fi

  U_CMD=$1
  shift
  _ED "command=$U_CMD args=$*"

  local alias=$U_CMD
  case "$U_CMD" in
    install|remove|rmpkg|upgrade) U_CMD=pkg ;;
    search) U_CMD=find ;;
    string) U_CMD=str ;;
    dates) U_CMD=date ;;
    password) U_CMD=pw ;;
    process) U_CMD=proc ;;
    syscheck) U_CMD=doctor ;;
    gitclone) U_CMD=clone ;;
    docker) U_CMD=dk ;;
    git) U_CMD=g ;;
    service) U_CMD=svc ;;
    quick) U_CMD=q ;;
    logfile) U_CMD=log ;;
    noproxy) U_CMD=np ;;
    update) U_CMD=self-update ;;
    sf) U_CMD=find ;;
    b64d|b64e) U_CMD=b64 ;;
    download|download-git) U_CMD=dl ;;
  esac

  if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
    u_usage "$U_CMD"
    return 0
  fi

  case "$alias" in
    install) set -- install "$@" ;;
    remove|rmpkg) set -- remove "$@" ;;
    upgrade)
      if [ "$#" -eq 0 ]; then
        set -- update
      else
        set -- upgrade "$@"
      fi
      ;;
    sf) set -- --name "$@" ;;
    b64d) set -- --decode "$@" ;;
    download-git) set -- --github "$@" ;;
  esac

  local fn="u_cmd_${U_CMD//-/_}"
  if command -v "$fn" >/dev/null 2>&1; then
    "$fn" "$@"
  else
    u_die 2 "unknown command: $U_CMD (see: u help)"
  fi
}

U_HELP_ALL=0
U_SELF=$(u_self_path)
U_SELF_DIR=$(cd -P "$(dirname "$U_SELF")" 2>/dev/null && pwd)
u_detect

if [ "${U_NO_MAIN:-0}" != 1 ] && [ "${BASH_SOURCE[0]}" = "$0" ]; then
  u_main "$@"
fi
