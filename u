# --- filesystem ------------------------------------------------------------
u_trash_read_info() {
  local d=$1
  if [ -f "$d/info" ]; then
    sed -n 's/^time=//p' "$d/info" | head -n 1
    sed -n 's/^original=//p' "$d/info" | head -n 1
  elif [ -f "$d/_U2_TRASH_INFO" ]; then
    sed -n 's/^dtime=//p' "$d/_U2_TRASH_INFO" | head -n 1
    sed -n 's/^originalDir=//p' "$d/_U2_TRASH_INFO" | head -n 1
  fi
}

u_trash_put() {
  [ "$#" -gt 0 ] || u_die 2 "usage: u trash <path...>"
  u_ensure_dirs
  local p abs home_abs id n dir rc=0
  home_abs=$(u_abs "$HOME")
  for p in "$@"; do
    if [ ! -e "$p" ]; then
      u_err "not found: $p"
      rc=1
      continue
    fi
    abs=$(u_abs "$p") || {
      u_err "cannot resolve: $p"
      rc=1
      continue
    }
    case "$abs" in
      /|"$home_abs"|"$U_DIR"|"$U_TRASH")
        u_err "refusing to trash a protected path: $abs"
        rc=1
        continue
        ;;
    esac
    id="$(date +%s)-$$"
    n=0
    while [ -e "$U_TRASH/$id" ]; do
      n=$((n + 1))
      id="$(date +%s)-$$-$n"
    done
    dir="$U_TRASH/$id"
    mkdir -p "$dir" || {
      u_err "cannot create trash entry: $dir"
      rc=1
      continue
    }
    printf 'original=%s\ntime=%s\n' "$abs" "$(u_now_iso)" >"$dir/info"
    if ! mv "$abs" "$dir/payload" 2>/dev/null; then
      rm -rf "$dir"
      u_err "cannot move to trash: $abs"
      rc=1
      continue
    fi
    printf '%s\t%s\n' "$id" "$abs"
    _ED "trashed $abs as $id"
  done
  return "$rc"
}

u_trash_list() {
  local d id info time orig size
  for d in "$U_TRASH"/*; do
    [ -d "$d" ] || continue
    id=${d##*/}
    info=$(u_trash_read_info "$d")
    time=$(printf '%s\n' "$info" | sed -n '1p')
    orig=$(printf '%s\n' "$info" | sed -n '2p')
    size=$(u_path_size "$d")
    [ -n "$orig" ] || continue
    printf '%s\t%s\t%s\t%s\n' "$id" "${time:-?}" "${size:-?}" "$orig"
  done | sort -r
}

u_trash_resolve() {
  local want=$1 d id found="" count=0
  for d in "$U_TRASH"/*; do
    [ -d "$d" ] || continue
    id=${d##*/}
    if [ "$id" = "$want" ]; then
      printf '%s\n' "$d"
      return 0
    fi
  done
  for d in "$U_TRASH"/*; do
    [ -d "$d" ] || continue
    id=${d##*/}
    case "$id" in
      "$want"*)
        found="${found}${id}"$'\n'
        count=$((count + 1))
        ;;
    esac
  done
  if [ "$count" -eq 1 ]; then
    printf '%s\n' "$U_TRASH/${found%$'\n'}"
    return 0
  fi
  if [ "$count" -gt 1 ]; then
    u_err "ambiguous trash id: $want"
    printf '%s' "$found" >&2
  fi
  return 1
}

u_trash_undo() {
  [ "$#" -gt 0 ] || u_die 2 "usage: u trash undo <id...>"
  local want d info time orig parent child rc=0
  for want in "$@"; do
    if ! d=$(u_trash_resolve "$want"); then
      u_err "trash entry not found: $want"
      rc=1
      continue
    fi
    info=$(u_trash_read_info "$d")
    time=$(printf '%s\n' "$info" | sed -n '1p')
    orig=$(printf '%s\n' "$info" | sed -n '2p')
    if [ -z "$orig" ]; then
      u_err "trash entry has no original path: $want"
      rc=1
      continue
    fi
    if [ -e "$orig" ]; then
      u_err "original path already exists: $orig"
      rc=1
      continue
    fi
    parent=$(dirname "$orig")
    mkdir -p "$parent" || {
      u_err "cannot create: $parent"
      rc=1
      continue
    }
    if [ -e "$d/payload" ]; then
      if ! mv "$d/payload" "$orig"; then
        u_err "cannot restore: $orig"
        rc=1
        continue
      fi
      rm -rf "$d"
    else
      # Legacy entry: move the children back into the original parent.
      for child in "$d"/*; do
        [ -e "$child" ] || continue
        case "$child" in
          */_U2_TRASH_INFO) continue ;;
        esac
        mv "$child" "$parent/" || rc=1
      done
      rm -rf "$d"
    fi
    printf 'restored\t%s\n' "$orig"
  done
  return "$rc"
}

u_trash_rm() {
  [ "$#" -gt 0 ] || u_die 2 "usage: u trash rm <id...>"
  local want d rc=0
  for want in "$@"; do
    if ! d=$(u_trash_resolve "$want"); then
      u_err "trash entry not found: $want"
      rc=1
      continue
    fi
    rm -rf "$d" && printf 'removed\t%s\n' "${d##*/}"
  done
  return "$rc"
}

u_trash_empty() {
  u_confirm "delete every entry in $U_TRASH?" || return 1
  find "$U_TRASH" -mindepth 1 -maxdepth 1 -exec rm -rf {} + 2>/dev/null
  printf 'trash emptied\n'
}

u_trash_clean() {
  local days=${1:-90}
  case "$days" in
    ''|*[!0-9]*) u_die 2 "days must be a number: $days" ;;
  esac
  local now limit d id info time epoch age target=""
  now=$(date +%s)
  limit=$((days * 86400))
  for d in "$U_TRASH"/*; do
    [ -d "$d" ] || continue
    id=${d##*/}
    info=$(u_trash_read_info "$d")
    time=$(printf '%s\n' "$info" | sed -n '1p')
    [ -n "$time" ] || continue
    epoch=$(u_epoch "$time" 2>/dev/null) || continue
    age=$((now - epoch))
    if [ "$age" -ge "$limit" ]; then
      target="${target}${id}"$'\n'
    fi
  done
  if [ -z "$target" ]; then
    printf 'nothing older than %s days\n' "$days"
    return 0
  fi
  printf '%s' "$target"
  u_confirm "delete the entries listed above?" || return 1
  local old_ifs=$IFS
  IFS=$'\n'
  for id in $target; do
    [ -n "$id" ] && rm -rf "$U_TRASH/$id"
  done
  IFS=$old_ifs
  printf 'cleaned\n'
}

#heavy
u_cmd_trash() {
  local argv=() a
  for a in "$@"; do
    case "$a" in
      --yes|-y) U_YES=1 ;;
      *) argv+=("$a") ;;
    esac
  done
  set -- "${argv[@]}"
  case "${1:-}" in
    "")
      u_die 2 "usage: u trash <path...> | ls | undo <id> | rm <id> | clean [days] | empty"
      ;;
    ls|list)
      u_trash_list
      ;;
    undo|restore)
      shift
      u_trash_undo "$@"
      ;;
    rm|delete)
      shift
      u_trash_rm "$@"
      ;;
    empty|purge)
      u_trash_empty
      ;;
    clean)
      shift
      u_trash_clean "$@"
      ;;
    *)
      u_trash_put "$@"
      ;;
  esac
}

u_cmd_stat() {
  local json=0 bytes=0 epoch=0 path="" a
  for a in "$@"; do
    case "$a" in
      --json) json=1 ;;
      --bytes) bytes=1 ;;
      --epoch) epoch=1 ;;
      -*) u_die 2 "unknown option: $a" ;;
      *) path=$a ;;
    esac
  done
  [ -n "$path" ] || u_die 2 "usage: u stat [--json] [--bytes] [--epoch] <path>"
  [ -e "$path" ] || u_die 1 "not found: $path"
  local size bytes_n mtime epoch_n
  size=$(u_path_size "$path")
  bytes_n=$(u_stat_bytes "$path")
  mtime=$(u_stat_mtime "$path")
  epoch_n=$(u_stat_epoch "$path")
  if [ "$json" = 1 ]; then
    printf '{"path":%s,"size":%s,"bytes":%s,"mtime":%s,"epoch":%s}\n' \
      "$(u_json_str "$path")" "$(u_json_str "$size")" "${bytes_n:-0}" \
      "$(u_json_str "$mtime")" "${epoch_n:-0}"
  elif [ "$bytes" = 1 ]; then
    printf '%s\n' "${bytes_n:-0}"
  elif [ "$epoch" = 1 ]; then
    printf '%s\n' "${epoch_n:-0}"
  else
    printf '%s\t%s\t%s\n' "${size:-?}" "${mtime:-?}" "$path"
  fi
}

#heavy
u_cmd_find() {
  local mode=content base="" ctx="" depth="" hidden=0 a
  local args=()
  while [ "$#" -gt 0 ]; do
    a=$1
    case "$a" in
      --name) mode=name ;;
      --base)
        shift
        base=${1:-}
        [ -n "$base" ] || u_die 2 "--base needs a directory"
        ;;
      --context|-C)
        shift
        ctx=${1:-}
        [ -n "$ctx" ] || u_die 2 "$a needs a number"
        ;;
      --depth)
        shift
        depth=${1:-}
        [ -n "$depth" ] || u_die 2 "--depth needs a number"
        ;;
      --hidden) hidden=1 ;;
      -*) u_die 2 "unknown option: $a" ;;
      *) args+=("$a") ;;
    esac
    shift
  done
  local pat=${args[0]:-}
  [ -n "$pat" ] || u_die 2 "usage: u find [--name] [--base DIR] <pattern> [base]"
  [ -z "$base" ] && base=${args[1]:-.}
  local base_is_file=0
  if [ -f "$base" ]; then
    base_is_file=1
  elif [ ! -d "$base" ]; then
    u_die 1 "not a file or directory: $base"
  fi

  if [ "$mode" = name ]; then
    if [ "$base_is_file" = 1 ]; then
      case "$(basename "$base")" in
        *"$pat"*) printf '%s\n' "$base"; return 0 ;;
        *) return 1 ;;
      esac
    fi
    local -a cmd=(find "$base")
    if [ "$hidden" = 0 ]; then
      cmd+=(-name '.?*' -prune -o)
    fi
    cmd+=(-path "$base/.git" -prune -o -path "$base/node_modules" -prune -o -type f -name "*$pat*" -print)
    [ -n "$depth" ] && u_warn "--depth is not supported with --name; ignored"
    local out
    out=$("${cmd[@]}" 2>/dev/null)
    [ -n "$out" ] && printf '%s\n' "$out"
    [ -n "$out" ]
    return
  fi

  if [ "$base_is_file" = 1 ]; then
    if u_has_cmd rg; then
      local -a cmd=(rg -n --no-heading --color never)
      [ -n "$ctx" ] && cmd+=(-C "$ctx")
      cmd+=(-- "$pat" "$base")
      "${cmd[@]}"
    elif u_has_cmd ag; then
      local -a cmd=(ag -n --nogroup --column --nocolor)
      [ -n "$ctx" ] && cmd+=(--context "$ctx")
      cmd+=(-- "$pat" "$base")
      "${cmd[@]}"
    else
      local -a cmd=(grep -n --binary-files=without-match)
      [ -n "$ctx" ] && cmd+=(-C "$ctx")
      cmd+=(-E -- "$pat" "$base")
      "${cmd[@]}"
    fi
    return
  fi

  if u_has_cmd rg; then
    local -a cmd=(rg -n --no-heading --color never)
    [ "$hidden" = 1 ] && cmd+=(--hidden)
    [ -n "$ctx" ] && cmd+=(-C "$ctx")
    [ -n "$depth" ] && cmd+=(--max-depth "$depth")
    cmd+=(-g '!node_modules' -g '!.git' -- "$pat" "$base")
    "${cmd[@]}"
  elif u_has_cmd ag; then
    local -a cmd=(ag -n --nogroup --column --nocolor)
    [ "$hidden" = 1 ] && cmd+=(--hidden)
    [ -n "$ctx" ] && cmd+=(--context "$ctx")
    [ -n "$depth" ] && cmd+=(--depth "$depth")
    cmd+=(--ignore node_modules --ignore .git -- "$pat" "$base")
    "${cmd[@]}"
  else
    local -a cmd=(grep -rn --binary-files=without-match --exclude-dir=.git --exclude-dir=node_modules)
    [ -n "$ctx" ] && cmd+=(-C "$ctx")
    cmd+=(-E -- "$pat" "$base")
    "${cmd[@]}"
  fi
}

u_cmd_recent() {
  local minutes="" count="" base="." a n=0
  while [ "$#" -gt 0 ]; do
    a=$1
    case "$a" in
      --base)
        shift
        base=${1:-}
        [ -n "$base" ] || u_die 2 "--base needs a directory"
        ;;
      --minutes)
        shift
        minutes=${1:-}
        ;;
      --count)
        shift
        count=${1:-}
        ;;
      -*) u_die 2 "unknown option: $a" ;;
      *)
        n=$((n + 1))
        if [ "$n" -eq 1 ]; then
          minutes=$a
        elif [ "$n" -eq 2 ]; then
          count=$a
        else
          u_die 2 "too many arguments"
        fi
        ;;
    esac
    shift
  done
  [ -n "$minutes" ] || minutes=30
  [ -n "$count" ] || count=20
  case "$minutes" in *[!0-9]*) u_die 2 "minutes must be a number: $minutes" ;; esac
  case "$count" in *[!0-9]*) u_die 2 "count must be a number: $count" ;; esac
  [ -d "$base" ] || u_die 1 "not a directory: $base"

  local lines
  if [ "$U_OS" = mac ]; then
    lines=$(find "$base" \( -name .git -o -name node_modules \) -prune -o -type f -mmin -"$minutes" -exec stat -f '%m %N' {} + 2>/dev/null)
  else
    lines=$(find "$base" \( -name .git -o -name node_modules \) -prune -o -type f -mmin -"$minutes" -exec stat -c '%Y %n' {} + 2>/dev/null)
  fi
  [ -n "$lines" ] || return 1
  printf '%s\n' "$lines" | sort -rn | head -n "$count" | while IFS= read -r line; do
    [ -n "$line" ] || continue
    local ts path
    ts=${line%% *}
    path=${line#* }
    printf '%s\t%s\n' "$(u_fmt_epoch "$ts" '%Y-%m-%d %H:%M:%S')" "$path"
  done
}

u_7z() {
  local z
  for z in 7z 7za 7zz; do
    if u_has_cmd "$z"; then
      printf '%s\n' "$z"
      return 0
    fi
  done
  return 1
}

u_cmd_zip() {
  local action=create out="" dest="" file="" a
  local targets=()
  while [ "$#" -gt 0 ]; do
    a=$1
    case "$a" in
      ls|list) action=list ;;
      unzip|extract|x) action=extract ;;
      --out|-o)
        shift
        out=${1:-}
        [ -n "$out" ] || u_die 2 "--out needs a file"
        ;;
      --dest|-d)
        shift
        dest=${1:-}
        [ -n "$dest" ] || u_die 2 "--dest needs a directory"
        ;;
      -*) u_die 2 "unknown option: $a" ;;
      *)
        if [ "$action" = list ] && [ -z "$file" ]; then
          file=$a
        elif [ "$action" = extract ] && [ -z "$file" ]; then
          file=$a
        else
          targets+=("$a")
        fi
        ;;
    esac
    shift
  done

  local z
  if [ "$action" = list ]; then
    [ -n "$file" ] || u_die 2 "usage: u zip ls <file>"
    [ -f "$file" ] || u_die 1 "not found: $file"
    if z=$(u_7z); then "$z" l "$file"; elif u_has_cmd unzip; then unzip -l "$file"; else u_die 3 "7z or unzip is required"; fi
    return
  fi

  if [ "$action" = extract ]; then
    [ -n "$file" ] || u_die 2 "usage: u zip unzip <file> [--dest DIR]"
    [ -f "$file" ] || u_die 1 "not found: $file"
    [ -n "$dest" ] || dest="${file%.*}"
    [ "$dest" = "$file" ] && dest="${file}_unzip"
    mkdir -p "$dest" || u_die 4 "cannot create: $dest"
    if z=$(u_7z); then
      "$z" x -y -bso0 -bsp0 -o"$dest" "$file"
    elif u_has_cmd unzip; then
      unzip -o "$file" -d "$dest"
    else
      u_die 3 "7z or unzip is required"
    fi
    printf 'extracted to %s\n' "$dest"
    return
  fi

  [ "${#targets[@]}" -gt 0 ] || u_die 2 "usage: u zip [--out FILE] <path...>"
  [ -n "$out" ] || out="$(u_fmt_epoch "$(date +%s)" '%Y_%m_%d_%H_%M_%S').zip"
  if z=$(u_7z); then
    "$z" a -y -bso0 -bsp0 "$out" "${targets[@]}"
  elif u_has_cmd zip; then
    zip -r -y "$out" "${targets[@]}"
  else
    u_die 3 "7z or zip is required"
  fi
  printf '%s\n' "$out"
}

# --- text and data ---------------------------------------------------------
u_cmd_str() {
  local op=${1:-}
  shift || true
  case "$op" in
    eq)
      [ "$#" -eq 2 ] || u_die 2 "usage: u str eq <a> <b>"
      [ "$1" = "$2" ]
      ;;
    contains)
      [ "$#" -eq 2 ] || u_die 2 "usage: u str contains <text> <needle>"
      case "$1" in
        *"$2"*) return 0 ;;
        *) return 1 ;;
      esac
      ;;
    replace)
      [ "$#" -eq 3 ] || u_die 2 "usage: u str replace <text> <search> <replacement>"
      [ -n "$2" ] || u_die 2 "search text must not be empty"
      printf '%s\n' "${1//$2/$3}"
      ;;
    num)
      [ "$#" -eq 1 ] || u_die 2 "usage: u str num <text>"
      case "$1" in
        ''|*[!0-9]*) return 1 ;;
        *) return 0 ;;
      esac
      ;;
    upper)
      [ "$#" -ge 1 ] || u_die 2 "usage: u str upper <text>"
      printf '%s\n' "$*" | tr '[:lower:]' '[:upper:]'
      ;;
    lower)
      [ "$#" -ge 1 ] || u_die 2 "usage: u str lower <text>"
      printf '%s\n' "$*" | tr '[:upper:]' '[:lower:]'
      ;;
    trim)
      [ "$#" -ge 1 ] || u_die 2 "usage: u str trim <text>"
      printf '%s\n' "$*" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//'
      ;;
    len)
      [ "$#" -ge 1 ] || u_die 2 "usage: u str len <text>"
      printf '%s\n' "${#1}"
      ;;
    *)
      u_die 2 "usage: u str <eq|contains|replace|num|upper|lower|trim|len> ..."
      ;;
  esac
}

#heavy
u_cmd_date() {
  local sub=${1:-}
  case "$sub" in
    "")
      u_now_iso
      ;;
    fmt)
      shift
      local fmt=${1:-"%Y-%m-%dT%H:%M:%S%z"}
      u_fmt_epoch "$(date +%s)" "$fmt"
      ;;
    epoch)
      shift
      [ "$#" -ge 1 ] || u_die 2 "usage: u date epoch <time>"
      u_epoch "$1" || u_die 2 "cannot parse time: $1"
      ;;
    show)
      shift
      [ "$#" -ge 1 ] || u_die 2 "usage: u date show <epoch> [format]"
      case "$1" in *[!0-9]*) u_die 2 "epoch must be a number: $1" ;; esac
      u_fmt_epoch "$1" "${2:-"%Y-%m-%dT%H:%M:%S%z"}"
      ;;
    age)
      shift
      [ "$#" -ge 1 ] || u_die 2 "usage: u date age <a> [b]"
      local a b
      a=$(u_epoch "$1") || u_die 2 "cannot parse time: $1"
      b=$(u_epoch "${2:-now}") || u_die 2 "cannot parse time: ${2:-now}"
      printf '%s\n' "$((b - a))"
      ;;
    older)
      shift
      [ "$#" -ge 2 ] || u_die 2 "usage: u date older <a> <b> [gap]"
      local a b gap=0
      a=$(u_epoch "$1") || u_die 2 "cannot parse time: $1"
      b=$(u_epoch "$2") || u_die 2 "cannot parse time: $2"
      [ "$#" -ge 3 ] && gap=$3
      case "$gap" in *[!0-9]*) u_die 2 "gap must be a number: $gap" ;; esac
      local age=$((b - a))
      [ "$age" -gt "$gap" ]
      ;;
    *)
      u_die 2 "usage: u date [fmt|epoch|show|age|older] ..."
      ;;
  esac
}

u_b64_read() {
  if [ "$#" -gt 0 ]; then
    printf '%s' "$*"
  elif [ ! -t 0 ]; then
    cat
  else
    return 1
  fi
}

u_b64_decode() {
  if [ "$U_OS" = mac ]; then
    base64 -D
  else
    base64 -d 2>/dev/null || base64 -D
  fi
}

u_cmd_b64() {
  local decode=0
  case "${1:-}" in
    --decode|-d) decode=1; shift ;;
  esac
  if [ "$#" -eq 0 ] && [ -t 0 ]; then
    u_die 2 "usage: u b64 [--decode] [text]  (or pipe text in)"
  fi
  if [ "$decode" = 1 ]; then
    u_b64_read "$@" | u_b64_decode
  else
    u_b64_read "$@" | base64 | tr -d '\n'
    printf '\n'
  fi
}

u_cmd_calc() {
  [ "$#" -gt 0 ] || u_die 2 "usage: u calc \"<expression>\""
  local expr="$*"
  [ -n "$expr" ] || u_die 2 "expression is empty"
  local bad
  bad=$(printf '%s' "$expr" | tr -d '0-9. +*/%^()-')
  [ -z "$bad" ] || u_die 2 "unsupported characters in expression: $bad"
  if u_has_cmd bc; then
    printf 'scale=10; %s\n' "$expr" | bc | sed -e 's/^\./0./' -e '/\./ s/0*$//' -e 's/\.$//'
  else
    awk "BEGIN { print ($expr) }"
  fi
}

#heavy
u_cmd_pw() {
  local len=${1:-16} symbols=0
  case "${2:-}" in
    --symbols|-s) symbols=1 ;;
  esac
  case "$len" in *[!0-9]*) u_die 2 "length must be a number: $len" ;; esac
  [ "$len" -ge 1 ] && [ "$len" -le 256 ] || u_die 2 "length must be 1..256"
  local chars='A-Za-z0-9'
  [ "$symbols" = 1 ] && chars='A-Za-z0-9!@#$%^&*()-_=+'
  LC_ALL=C tr -dc "$chars" </dev/urandom | head -c "$len"
  printf '\n'
}

u_cmd_uuid() {
  if [ -r /proc/sys/kernel/random/uuid ]; then
    cat /proc/sys/kernel/random/uuid
  elif u_has_cmd uuidgen; then
    uuidgen | tr 'A-Z' 'a-z'
  else
    printf '%04x%04x-%04x-4%03x-%04x-%04x%04x%04x\n' \
      "$RANDOM" "$RANDOM" "$RANDOM" "$((RANDOM % 4096))" \
      "$((RANDOM % 4096))" "$RANDOM" "$RANDOM" "$RANDOM"
  fi
}

u_cmd_clip() {
  local input
  if [ "$#" -gt 0 ]; then
    input="$*"
  elif [ ! -t 0 ]; then
    input=$(cat)
  else
    u_die 2 "usage: u clip [text] (or pipe text in)"
  fi
  if [ "$U_OS" = mac ]; then
    printf '%s' "$input" | pbcopy
  elif [ "$U_OS" = windows ]; then
    printf '%s' "$input" | clip.exe
  elif u_has_cmd wl-copy; then
    printf '%s' "$input" | wl-copy
  elif u_has_cmd xclip; then
    printf '%s' "$input" | xclip -selection clipboard
  elif u_has_cmd xsel; then
    printf '%s' "$input" | xsel --clipboard --input
  else
    u_die 3 "no clipboard command found"
  fi
}

# --- network ---------------------------------------------------------------
u_public_ip() {
  local fam=$1 url ip
  local urls
  if [ "$fam" = 6 ]; then
    urls="https://ipv6.icanhazip.com https://api6.ipify.org https://ifconfig.co/ip"
  else
    urls="https://ipv4.icanhazip.com https://api.ipify.org https://ifconfig.me/ip https://ident.me"
  fi
  for url in $urls; do
    if u_has_cmd curl; then
      ip=$(curl "-$fam" -fsS --max-time 6 "$url" 2>/dev/null | tr -d '[:space:]')
    elif u_has_cmd wget; then
      ip=$(wget -qO- --timeout=6 "$url" 2>/dev/null | tr -d '[:space:]')
    else
      return 1
    fi
    [ -n "$ip" ] && { printf '%s\n' "$ip"; return 0; }
  done
  return 1
}

u_private_ip() {
  local ip="" i
  case "$U_OS" in
    mac)
      for i in en0 en1 en2; do
        ip=$(ipconfig getifaddr "$i" 2>/dev/null)
        [ -n "$ip" ] && break
      done
      if [ -z "$ip" ] && u_has_cmd route; then
        i=$(route -n get default 2>/dev/null | awk '/interface:/{print $2; exit}')
        [ -n "$i" ] && ip=$(ipconfig getifaddr "$i" 2>/dev/null)
      fi
      ;;
    linux)
      if u_has_cmd hostname; then
        ip=$(hostname -I 2>/dev/null | awk '{print $1}')
      fi
      if [ -z "$ip" ] && u_has_cmd ip; then
        ip=$(ip route get 1.1.1.1 2>/dev/null | awk '{for (i=1; i<=NF; i++) if ($i == "src") { print $(i+1); exit }}')
      fi
      ;;
    windows)
      ip=$(ipconfig 2>/dev/null | tr -d '\r' | awk '/IPv4 Address|IPv4 地址/ {print $NF; exit}')
      ;;
  esac
  [ -n "$ip" ] || return 1
  printf '%s\n' "$ip"
}

#heavy
u_cmd_ip() {
  local mode=public fam=4 rc=0
  local a
  for a in "$@"; do
    case "$a" in
      local|private|lan) mode=local ;;
      --6|-6) fam=6 ;;
      --4|-4) fam=4 ;;
      all)
        mode=all
        ;;
      *) u_die 2 "usage: u ip [local|all] [-4|-6]" ;;
    esac
  done
  case "$mode" in
    local)
      u_private_ip || u_die 1 "could not determine a private IP"
      ;;
    all)
      local got=0
      u_public_ip 4 && got=1
      u_public_ip 6 && got=1
      [ "$got" = 1 ] || rc=1
      return "$rc"
      ;;
    *)
      u_public_ip "$fam" || u_die 1 "could not determine the public IPv$fam"
      ;;
  esac
}

#heavy
u_cmd_get() {
  local head=0 out="" fam="" url="" a
  while [ "$#" -gt 0 ]; do
    a=$1
    case "$a" in
      --head|-I) head=1 ;;
      -o)
        shift
        out=${1:-}
        [ -n "$out" ] || u_die 2 "-o needs a file"
        ;;
      -4) fam=4 ;;
      -6) fam=6 ;;
      -*) u_die 2 "unknown option: $a" ;;
      *) url=$a ;;
    esac
    shift
  done
  [ -n "$url" ] || u_die 2 "usage: u get [--head] [-o FILE] [-4|-6] <url>"
  if u_has_cmd curl; then
    local -a cmd=(curl -fsSL --max-time "$U_TIMEOUT")
    [ -n "$fam" ] && cmd+=("-$fam")
    [ "$head" = 1 ] && cmd+=(-I)
    [ -n "$out" ] && cmd+=(-o "$out")
    cmd+=("$url")
    "${cmd[@]}"
  elif u_has_cmd wget; then
    [ "$head" = 1 ] && u_warn "--head needs curl; using a normal GET"
    if [ -n "$out" ]; then
      wget -q -O "$out" "$url"
    else
      wget -qO- "$url"
    fi
  else
    u_die 3 "curl or wget is required"
  fi
}

u_cmd_post() {
  local ctype="application/json" data="" file="" url="" a
  while [ "$#" -gt 0 ]; do
    a=$1
    case "$a" in
      --form) ctype="application/x-www-form-urlencoded" ;;
      --text) ctype="text/plain" ;;
      --file)
        shift
        file=${1:-}
        [ -n "$file" ] || u_die 2 "--file needs a path"
        ;;
      -*) u_die 2 "unknown option: $a" ;;
      *)
        if [ -z "$url" ]; then
          url=$a
        else
          data="$data $a"
        fi
        ;;
    esac
    shift
  done
  [ -n "$url" ] || u_die 2 "usage: u post [--form|--text|--file FILE] <url> [data]"
  u_has_cmd curl || u_die 3 "curl is required"
  local -a cmd=(curl -fsSL --max-time "$U_TIMEOUT" -X POST -H "Content-Type: $ctype")
  if [ -n "$file" ]; then
    [ -f "$file" ] || u_die 1 "not found: $file"
    cmd+=(--data-binary "@$file")
  elif [ -n "$data" ]; then
    cmd+=(--data-binary "${data# }")
  else
    cmd+=(--data-binary "")
  fi
  cmd+=("$url")
  "${cmd[@]}"
}

u_download_file() {
  local url=$1 out=$2 fam=$3
  if u_has_cmd curl; then
    local -a cmd=(curl -fsSL --retry 2 --max-time 300)
    [ -n "$fam" ] && cmd+=("-$fam")
    cmd+=(-o "$out" "$url")
    "${cmd[@]}"
  elif u_has_cmd wget; then
    wget -q -O "$out" "$url"
  else
    u_die 3 "curl or wget is required"
  fi
}

#heavy
u_cmd_dl() {
  local github=0 out="" fam="" url="" a
  while [ "$#" -gt 0 ]; do
    a=$1
    case "$a" in
      --github) github=1 ;;
      -o)
        shift
        out=${1:-}
        [ -n "$out" ] || u_die 2 "-o needs a file"
        ;;
      -4) fam=4 ;;
      -6) fam=6 ;;
      -*) u_die 2 "unknown option: $a" ;;
      *) url=$a ;;
    esac
    shift
  done
  [ -n "$url" ] || u_die 2 "usage: u dl [-o FILE] [--github] [-4|-6] <url>"
  if [ -z "$out" ]; then
    out=${url%%\?*}
    out=${out##*/}
    [ -n "$out" ] || out="download"
  fi
  if [ "$github" = 1 ]; then
    local prefix
    for prefix in "https://fastgit.cc/" "https://gh.ddlc.top/" "http://ghfast.top/" "https://ghproxy.monkeyray.net/" "https://cdn.akaere.online/" ""; do
      _ED "download via ${prefix:-direct}"
      if u_download_file "${prefix}${url}" "$out" "$fam"; then
        [ -s "$out" ] && { printf '%s\n' "$out"; return 0; }
      fi
      rm -f "$out"
    done
    u_die 1 "download failed: $url"
  fi
  u_download_file "$url" "$out" "$fam" || u_die 1 "download failed: $url"
  printf '%s\n' "$out"
}

u_cmd_dns() {
  if [ "$#" -eq 0 ]; then
    case "$U_OS" in
      mac) scutil --dns 2>/dev/null | awk '/nameserver\[[0-9]+\]/{print $3}' | sort -u ;;
      linux)
        if u_has_cmd resolvectl; then
          resolvectl dns 2>/dev/null
        else
          awk '/^nameserver/{print $2}' /etc/resolv.conf 2>/dev/null
        fi
        ;;
      windows) ipconfig /all 2>/dev/null | tr -d '\r' | grep -i -A1 'DNS Servers' ;;
      *) cat /etc/resolv.conf 2>/dev/null ;;
    esac
    return
  fi
  local domain=$1
  [ -n "$domain" ] || u_die 2 "usage: u dns <domain>"
  case "$U_OS" in
    mac) dscacheutil -q host -a name "$domain" 2>/dev/null | awk '/ip_address/{print $2}' ;;
    linux) getent hosts "$domain" 2>/dev/null | awk '{print $1}' ;;
    *) nslookup "$domain" 2>/dev/null | awk '/^Address: /{print $2}' ;;
  esac
}

# --- processes and sessions ------------------------------------------------
u_port_list() {
  case "$U_OS" in
    mac)
      lsof -nP -iTCP -sTCP:LISTEN
      ;;
    linux)
      if u_has_cmd ss; then
        ss -ltnp
      elif u_has_cmd netstat; then
        netstat -ltnp
      elif u_has_cmd lsof; then
        lsof -nP -iTCP -sTCP:LISTEN
      else
        u_die 3 "ss, netstat or lsof is required"
      fi
      ;;
    windows)
      netstat -ano
      ;;
    *)
      u_die 3 "unsupported platform for port listing"
      ;;
  esac
}

u_port_busy() {
  local n=$1
  if u_has_cmd lsof; then
    lsof -nP -iTCP:"$n" -sTCP:LISTEN >/dev/null 2>&1 && return 0
    return 1
  fi
  (exec 3<>"/dev/tcp/127.0.0.1/$n") 2>/dev/null && return 0
  return 1
}

u_port_pid() {
  local n=$1
  case "$U_OS" in
    mac)
      lsof -nP -iTCP:"$n" -sTCP:LISTEN 2>/dev/null | awk 'NR > 1 { print $2; exit }'
      ;;
    linux)
      if u_has_cmd ss; then
        ss -ltnp 2>/dev/null | grep -F ":$n " | sed -n 's/.*pid=\([0-9][0-9]*\).*/\1/p' | head -n 1
      elif u_has_cmd fuser; then
        fuser -n tcp "$n" 2>/dev/null | awk '{print $1; exit}'
      fi
      ;;
    windows)
      netstat -ano 2>/dev/null | grep -F ":$n " | awk '$4 == "LISTENING" { print $5; exit }'
      ;;
  esac
}

#heavy
u_cmd_port() {
  local argv=() a
  for a in "$@"; do
    case "$a" in
      --yes|-y) U_YES=1 ;;
      *) argv+=("$a") ;;
    esac
  done
  set -- "${argv[@]}"
  local sub=${1:-}
  case "$sub" in
    ""|list|ls)
      u_port_list
      ;;
    free)
      shift
      [ "$#" -ge 1 ] || u_die 2 "usage: u port free <number>"
      case "$1" in *[!0-9]*) u_die 2 "port must be a number: $1" ;; esac
      if u_port_busy "$1"; then return 1; else return 0; fi
      ;;
    kill)
      shift
      [ "$#" -ge 1 ] || u_die 2 "usage: u port kill <number> [--yes]"
      local n=$1 pid
      case "$n" in *[!0-9]*) u_die 2 "port must be a number: $n" ;; esac
      pid=$(u_port_pid "$n")
      [ -n "$pid" ] || u_die 1 "no listener found on port $n"
      printf 'port %s -> pid %s\n' "$n" "$pid"
      ps -o pid,ppid,user,command -p "$pid" 2>/dev/null || true
      u_confirm "kill pid $pid?" || return 1
      kill "$pid" 2>/dev/null || u_die 1 "kill failed for pid $pid"
      sleep 1
      if kill -0 "$pid" 2>/dev/null; then
        u_err "pid $pid is still alive"
        return 1
      fi
      printf 'killed pid %s\n' "$pid"
      ;;
    *)
      local out
      out=$(u_port_list)
      case "$sub" in
        *[!0-9]*)
          printf '%s\n' "$out" | grep -F -- "$sub"
          ;;
        *)
          printf '%s\n' "$out" | grep -F ":$sub "
          ;;
      esac
      ;;
  esac
}

#heavy
u_cmd_pid() {
  [ "$#" -ge 1 ] || u_die 2 "usage: u pid <pid|name>"
  local target=$1
  case "$target" in
    *[!0-9]*)
      if u_has_cmd pgrep; then
        pgrep -fl "$target" || u_die 1 "no process matches: $target"
      else
        ps aux | grep -F -- "$target" | grep -v grep || u_die 1 "no process matches: $target"
      fi
      ;;
    *)
      ps -o pid,ppid,user,command -p "$target" 2>/dev/null || u_die 1 "pid not found: $target"
      local p=$target n=0
      while [ -n "$p" ] && [ "$p" != 0 ] && [ "$p" != 1 ] && [ "$n" -lt 20 ]; do
        p=$(ps -o ppid= -p "$p" 2>/dev/null | tr -d ' ')
        [ -n "$p" ] || break
        [ "$p" = 1 ] && break
        printf '%s\n' '--- parent ---'
        ps -o pid,ppid,user,command -p "$p" 2>/dev/null
        n=$((n + 1))
      done
      if u_has_cmd lsof; then
        printf '%s\n' '--- listeners ---'
        lsof -nP -a -p "$target" -iTCP -sTCP:LISTEN 2>/dev/null | tail -n +2
      fi
      ;;
  esac
}

#heavy
u_cmd_proc() {
  local argv=() a
  for a in "$@"; do
    case "$a" in
      --yes|-y) U_YES=1 ;;
      *) argv+=("$a") ;;
    esac
  done
  set -- "${argv[@]}"
  local mode=cpu q="" target=""
  case "${1:-}" in
    "")
      mode=cpu
      ;;
    --cpu|-c)
      mode=cpu
      ;;
    --mem|-m)
      mode=mem
      ;;
    kill)
      mode=kill
      shift
      target=${1:-}
      [ -n "$target" ] || u_die 2 "usage: u proc kill <name|pid> [--yes]"
      ;;
    *)
      mode=grep
      q=$1
      ;;
  esac

  if ! ps aux >/dev/null 2>&1; then
    u_die 3 "ps is not usable on this system"
  fi

  case "$mode" in
    cpu)
      ps aux | head -n 1
      ps aux | tail -n +2 | sort -k3,3 -n -r | head -n 15
      ;;
    mem)
      ps aux | head -n 1
      ps aux | tail -n +2 | sort -k4,4 -n -r | head -n 15
      ;;
    grep)
      ps aux | head -n 1
      ps aux | grep -F -- "$q" | grep -v grep
      ;;
    kill)
      case "$target" in
        *[!0-9]*)
          ps aux | grep -F -- "$target" | grep -v grep || u_die 1 "no process matches: $target"
          u_confirm "kill every process matching $target?" || return 1
          pkill -f "$target" 2>/dev/null || u_die 1 "pkill failed: $target"
          printf 'sent TERM to processes matching %s\n' "$target"
          ;;
        *)
          ps -o pid,command -p "$target" 2>/dev/null || u_die 1 "pid not found: $target"
          u_confirm "kill pid $target?" || return 1
          kill "$target" 2>/dev/null || u_die 1 "kill failed: $target"
          printf 'sent TERM to pid %s\n' "$target"
          ;;
      esac
      ;;
  esac
}

u_screen_sessions() {
  screen -ls 2>/dev/null | awk '/Detached|Attached/ { print $1 }'
}

#heavy
u_cmd_screen() {
  u_need_cmd screen
  local argv=() a
  for a in "$@"; do
    case "$a" in
      --yes|-y) U_YES=1 ;;
      *) argv+=("$a") ;;
    esac
  done
  set -- "${argv[@]}"
  local sub=${1:-}
  case "$sub" in
    "")
      [ -z "${STY:-}" ] || u_die 4 "already inside screen; use: u screen detach"
      local sessions
      sessions=$(u_screen_sessions)
      if [ -z "$sessions" ]; then
        [ -t 0 ] || u_die 4 "screen needs a tty; run u screen new <name> from a terminal"
        screen -S u
      elif [ "$(printf '%s\n' "$sessions" | wc -l | tr -d ' ')" = 1 ]; then
        screen -r "$sessions"
      else
        local pick
        pick=$(u_choose "choose a screen session:" $sessions) || {
          printf '%s\n' "$sessions"
          u_die 2 "choose a session: u screen attach <name>"
        }
        screen -r "$pick"
      fi
      ;;
    ls|list)
      if ! screen -ls 2>/dev/null; then
        printf 'no screen sessions\n'
      fi
      ;;
    new)
      [ -z "${STY:-}" ] || u_die 4 "already inside screen"
      shift
      local name=${1:-u}
      [ -t 0 ] || u_die 4 "screen needs a tty"
      screen -S "$name"
      ;;
    attach|a|r)
      shift
      [ "$#" -ge 1 ] || u_die 2 "usage: u screen attach <name>"
      local target=$1
      if ! screen -ls 2>/dev/null | grep -qF "$target"; then
        u_die 1 "no screen session matches: $target"
      fi
      screen -r "$target"
      ;;
    detach)
      if [ -n "${STY:-}" ]; then
        screen -X detach
      else
        screen -d
      fi
      ;;
    kill)
      shift
      local sessions target
      sessions=$(u_screen_sessions)
      target=${1:-}
      if [ -z "$target" ] && [ -n "${STY:-}" ]; then
        target=$STY
      fi
      if [ -z "$target" ]; then
        if [ "$(printf '%s\n' "$sessions" | grep -c .)" = 1 ]; then
          target=$sessions
        else
          u_die 2 "usage: u screen kill <name> (or run inside the session)"
        fi
      fi
      if ! printf '%s\n' "$sessions" | grep -qF "$target"; then
        u_die 1 "no screen session matches: $target"
      fi
      u_confirm "quit screen session $target?" || return 1
      screen -S "$target" -X quit
      printf 'quit %s\n' "$target"
      ;;
    *)
      u_die 2 "usage: u screen [ls|new|attach|detach|kill]"
      ;;
  esac
}

