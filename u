u_cmd_has() {
  local kind=${1:-}
  shift || true
  [ -n "$kind" ] && [ "$#" -gt 0 ] || u_die 2 "usage: u has <cmd|file|dir|path|env> <name...>"
  local n missing=0
  for n in "$@"; do
    case "$kind" in
      cmd)
        if ! u_has_cmd "$n"; then
          u_log "missing command: $n"
          missing=$((missing + 1))
        fi
        ;;
      file)
        if [ ! -f "$n" ]; then
          u_log "missing file: $n"
          missing=$((missing + 1))
        fi
        ;;
      dir)
        if [ ! -d "$n" ]; then
          u_log "missing directory: $n"
          missing=$((missing + 1))
        fi
        ;;
      path)
        if [ ! -e "$n" ]; then
          u_log "missing path: $n"
          missing=$((missing + 1))
        fi
        ;;
      env)
        if ! u_valid_env_name "$n"; then
          u_log "invalid env name: $n"
          missing=$((missing + 1))
        elif ! eval "[ \${$n+x} ]"; then
          u_log "missing env: $n"
          missing=$((missing + 1))
        fi
        ;;
      *)
        u_die 2 "unknown has kind: $kind"
        ;;
    esac
  done
  [ "$missing" -eq 0 ]
}

u_cmd_env() {
  if [ "$#" -eq 0 ]; then
    printf 'U_VERSION=%s\n' "$U_VERSION"
    printf 'U_OS=%s\n' "$U_OS"
    printf 'U_ARCH=%s\n' "$U_ARCH"
    printf 'U_DIR=%s\n' "$U_DIR"
    printf 'U_BIN=%s\n' "$U_BIN"
    printf 'U_DEBUG=%s\n' "$U_DEBUG"
    printf 'U_TIMEOUT=%s\n' "$U_TIMEOUT"
    printf 'U_PKG=%s\n' "$(u_pkg_mgr)"
    printf 'SHELL=%s\n' "${SHELL:-}"
    return 0
  fi
  local name=$1 default=${2:-} has_default=0
  [ "$#" -ge 2 ] && has_default=1
  u_valid_env_name "$name" || u_die 2 "invalid env name: $name"
  if eval "[ \${$name+x} ]"; then
    printf '%s\n' "${!name}"
  elif [ "$has_default" = 1 ]; then
    printf '%s\n' "$default"
  else
    return 1
  fi
}

