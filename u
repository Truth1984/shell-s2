#!/usr/bin/env bash
# shell-s2 / u: one small cross-platform CLI for daily tasks.
# Author: Awada.Z
# License: MIT (see LICENSE)
#
# Design rules
# - bash 3.2+ (macOS /bin/bash), no associative arrays, no `local -n`.
# - one file, one entry point: `u <command> [args...]`.
# - stdout is the result; stderr is diagnostics; the exit code is the outcome.
# - prompts only on a tty; `--yes` skips them.
# - commands marked `#heavy` below are daily-use commands.
# - commands whose name starts with `_` are debug helpers for humans and LLMs.
#
# Exit codes: 0 ok, 1 failure or predicate false, 2 usage, 3 missing dependency,
# 4 environment, 5 conflict or lock.

U_VERSION="2.0.0"
U_NAME="u"
U_REPO="Truth1984/shell-s2"
U_BRANCH="main"
U_RAW="https://raw.githubusercontent.com/${U_REPO}/${U_BRANCH}/u"

# --- state -----------------------------------------------------------------
# Keep the legacy state root so existing quick commands and trash survive.
U_DIR="${U_DIR:-$HOME/.application}"
case "$U_DIR" in
  "~") U_DIR="$HOME" ;;
  "~/"*) U_DIR="$HOME/${U_DIR#\~/}" ;;
esac
U_BIN="$U_DIR/bin"
U_QUICK="$U_DIR/quick"
U_TRASH="$U_DIR/.trash"

U_DEBUG="${U_DEBUG:-0}"
case "$U_DEBUG" in
  1|true|TRUE|yes|on) U_DEBUG=1 ;;
  *) U_DEBUG=0 ;;
esac
U_YES=0
U_JSON=0
U_CMD=""
U_OS=""
U_ARCH=""
U_GNU_DATE=0
U_PKG=""
U_PKG_DETECTED=0
U_TIMEOUT="${U_TIMEOUT:-60}"

# --- small helpers ---------------------------------------------------------
u_log() {
  [ "$U_DEBUG" = 1 ] || return 0
  printf '%s u[%s] %s\n' "$(date +"%H:%M:%S" 2>/dev/null || printf -- '--:--:--')" "$$" "$*" >&2
}

# Debug logger used inside u; silent unless U_DEBUG=1.
_ED() {
  u_log "$@"
}

# Debug command entry point: always prints, even when U_DEBUG is off.
u_cmd__ED() {
  printf 'ED %s u[%s] %s\n' "$(u_now_iso)" "$$" "$*" >&2
  return 0
}

# Return callback: log, then exit with the given code.
_RC() {
  local code="${1:-0}"
  shift || true
  [ "$#" -gt 0 ] && u_log "$*"
  exit "$code"
}

u_cmd__RC() {
  local code="${1:-0}"
  shift || true
  [ "$#" -gt 0 ] && u_cmd__ED "$*" >&2
  exit "$code"
}

u_die() {
  local code="${1:-1}"
  shift || true
  printf 'u: %s\n' "$*" >&2
  exit "$code"
}

u_err() {
  printf 'u: %s\n' "$*" >&2
}

u_warn() {
  printf 'u: warning: %s\n' "$*" >&2
}

u_has_cmd() {
  command -v "$1" >/dev/null 2>&1
}

u_need_cmd() {
  u_has_cmd "$1" || u_die 3 "required command not found: $1"
}

u_expand() {
  case "$1" in
    "~") printf '%s\n' "$HOME" ;;
    "~/"*) printf '%s\n' "$HOME/${1#\~/}" ;;
    *) printf '%s\n' "$1" ;;
  esac
}

u_abs() {
  local p=$1
  case "$p" in
    /*) printf '%s\n' "$p"; return 0 ;;
  esac
  if [ -d "$p" ]; then
    (cd -P "$p" 2>/dev/null && pwd)
    return $?
  fi
  local d b
  d=$(dirname "$p")
  b=$(basename "$p")
  (cd -P "$d" 2>/dev/null && printf '%s/%s\n' "$(pwd)" "$b")
}

u_now_iso() {
  date +"%Y-%m-%dT%H:%M:%S%z"
}

u_scan_yes() {
  local a
  for a in "$@"; do
    case "$a" in
      --yes|-y) U_YES=1 ;;
    esac
  done
}

u_confirm() {
  local prompt=$1
  if [ "$U_YES" = 1 ]; then return 0; fi
  if [ ! -t 0 ]; then
    u_die 2 "$prompt (non-interactive: pass --yes)"
  fi
  printf '%s [y/N] ' "$prompt" >&2
  local a=""
  read -r a || return 1
  case "$a" in
    y|Y|yes|YES|Yes) return 0 ;;
    *) return 1 ;;
  esac
}

u_choose() {
  local prompt=$1
  shift
  local items=("$@")
  local n=${#items[@]}
  [ "$n" -gt 0 ] || return 1
  if [ "$n" -eq 1 ]; then printf '%s\n' "${items[0]}"; return 0; fi
  if [ ! -t 0 ]; then
    printf '%s\n' "$prompt" >&2
    printf '  %s\n' "${items[@]}" >&2
    return 1
  fi
  printf '%s\n' "$prompt" >&2
  local i=0
  while [ "$i" -lt "$n" ]; do
    printf '  [%s] %s\n' "$i" "${items[$i]}" >&2
    i=$((i + 1))
  done
  printf 'choice [0]: ' >&2
  local ans=""
  read -r ans || return 1
  case "$ans" in
    "") printf '%s\n' "${items[0]}" ;;
    *[!0-9]*) return 1 ;;
    *)
      [ "$ans" -lt "$n" ] || return 1
      printf '%s\n' "${items[$ans]}"
      ;;
  esac
}

u_prompt() {
  local msg=$1
  [ -t 0 ] || return 1
  printf '%s ' "$msg" >&2
  local a=""
  read -r a || return 1
  printf '%s\n' "$a"
}

u_json_str() {
  printf '"%s"' "$(printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g')"
}

u_valid_name() {
  case "$1" in
    ''|.|..|-*|*[!A-Za-z0-9._-]*) return 1 ;;
    *) return 0 ;;
  esac
}

u_valid_env_name() {
  case "$1" in
    ''|[0-9]*|*[!A-Za-z0-9_]*) return 1 ;;
    *) return 0 ;;
  esac
}

u_ensure_dirs() {
  [ -d "$U_DIR" ] && [ -d "$U_BIN" ] && [ -d "$U_QUICK" ] && [ -d "$U_TRASH" ] && return 0
  mkdir -p "$U_DIR" "$U_BIN" "$U_QUICK" "$U_TRASH" 2>/dev/null ||
    u_die 4 "cannot create state directory: $U_DIR"
}

# --- platform --------------------------------------------------------------
u_detect() {
  U_ARCH=$(uname -m 2>/dev/null || printf 'unknown')
  case "$(uname -s 2>/dev/null)" in
    Darwin) U_OS=mac ;;
    Linux) U_OS=linux ;;
    MINGW*|MSYS*|CYGWIN*) U_OS=windows ;;
    *) U_OS=unknown ;;
  esac
  if date --version >/dev/null 2>&1; then U_GNU_DATE=1; else U_GNU_DATE=0; fi
}

u_pkg_mgr() {
  if [ "$U_PKG_DETECTED" = 0 ]; then
    U_PKG=""
    case "$U_OS" in
      mac)
        u_has_cmd brew && U_PKG=brew
        [ -z "$U_PKG" ] && u_has_cmd port && U_PKG=port
        ;;
      windows)
        u_has_cmd choco && U_PKG=choco
        [ -z "$U_PKG" ] && u_has_cmd winget && U_PKG=winget
        ;;
      *)
        u_has_cmd apt-get && U_PKG=apt
        [ -z "$U_PKG" ] && u_has_cmd dnf && U_PKG=dnf
        [ -z "$U_PKG" ] && u_has_cmd yum && U_PKG=yum
        [ -z "$U_PKG" ] && u_has_cmd pacman && U_PKG=pacman
        [ -z "$U_PKG" ] && u_has_cmd apk && U_PKG=apk
        [ -z "$U_PKG" ] && u_has_cmd brew && U_PKG=brew
        ;;
    esac
    U_PKG_DETECTED=1
  fi
  printf '%s\n' "${U_PKG:-none}"
}

u_is_root() {
  [ "$(id -u 2>/dev/null || printf '1')" = 0 ]
}

# Run a privileged command. On a non-tty, sudo must not prompt.
u_root() {
  if [ "$U_OS" = linux ] && ! u_is_root && u_has_cmd sudo; then
    if [ ! -t 0 ]; then
      sudo -n "$@" || u_die 4 "sudo requires a password (non-interactive)"
    else
      sudo "$@"
    fi
  else
    "$@"
  fi
}

u_sudo_cmd() {
  if ! u_is_root && u_has_cmd sudo; then
    if [ ! -t 0 ]; then
      sudo -n "$@" || u_die 4 "sudo requires a password (non-interactive)"
    else
      sudo "$@"
    fi
  else
    "$@"
  fi
}

u_disk_pct() {
  df -Pk "$1" 2>/dev/null | awk 'NR==2 { gsub("%", "", $5); print $5 }'
}

u_cores() {
  if u_has_cmd nproc; then
    nproc
  elif [ "$U_OS" = mac ]; then
    sysctl -n hw.ncpu 2>/dev/null || printf '1'
  else
    printf '1'
  fi
}

u_load1() {
  uptime 2>/dev/null | sed -E 's/.*load averages?: *//' | awk '{ print $1 }'
}

# --- time ------------------------------------------------------------------
u_epoch() {
  local s=${1:-}
  [ -n "$s" ] || return 1
  case "$s" in
    now) date +%s; return 0 ;;
  esac
  case "$s" in
    *[!0-9]*) ;;
    *) printf '%s\n' "$s"; return 0 ;;
  esac
  local norm=$s
  case "$norm" in
    ????_??_??_??_??_??)
      norm="${norm:0:4}-${norm:5:2}-${norm:8:2} ${norm:11:2}:${norm:14:2}:${norm:17:2}"
      ;;
  esac
  case "$norm" in
    *T*) norm=$(printf '%s' "$norm" | tr 'T' ' ') ;;
  esac
  if [ "$U_GNU_DATE" = 1 ]; then
    date -d "$norm" +%s 2>/dev/null && return 0
  else
    date -j -f "%Y-%m-%d %H:%M:%S" "$norm" +%s 2>/dev/null && return 0
    date -j -f "%Y-%m-%d" "$norm" +%s 2>/dev/null && return 0
  fi
  return 1
}

u_fmt_epoch() {
  local e=$1 f=$2
  if [ "$U_GNU_DATE" = 1 ]; then
    date -d "@$e" +"$f"
  else
    date -r "$e" +"$f"
  fi
}

u_stat_epoch() {
  if [ "$U_OS" = mac ]; then
    stat -f "%m" "$1" 2>/dev/null
  else
    stat -c "%Y" "$1" 2>/dev/null
  fi
}

u_stat_mtime() {
  if [ "$U_OS" = mac ]; then
    stat -f "%Sm" -t "%Y-%m-%d %H:%M:%S" "$1" 2>/dev/null
  else
    stat -c "%y" "$1" 2>/dev/null | cut -d. -f1
  fi
}

u_stat_bytes() {
  if [ "$U_OS" = mac ]; then
    stat -f "%z" "$1" 2>/dev/null
  else
    stat -c "%s" "$1" 2>/dev/null
  fi
}

u_path_size() {
  du -sh "$1" 2>/dev/null | awk '{ print $1 }'
}

u_shell_name() {
  basename "${SHELL:-/bin/sh}"
}

# --- catalog, help and dispatch -------------------------------------------
# name|group|heavy|summary
u_catalog() {
  cat <<'EOF'
help|core|1|show help for u or one command
version|core|0|print the u version
commands|core|0|list commands as TSV (--all includes debug helpers)
setup|core|1|install u into the state bin and add it to PATH
self-update|core|0|download and install the newest u
doctor|core|1|check platform, tools, disk and load
os|core|1|show the platform, package manager, or test an OS trait
has|core|0|test for a command, file, directory, path or env var
env|core|0|print one env var or the u settings
np|core|1|run a command with proxy variables cleared
pkg|core|1|install, update, remove and search packages
trash|fs|1|move files to trash, list, undo, clean
stat|fs|0|print size and mtime of a path
find|fs|1|search file contents or names
recent|fs|0|list recently modified files
zip|fs|0|create, list or extract an archive
str|text|0|string tests and transforms
date|text|1|format, parse and compare dates
b64|text|0|base64 encode or decode
calc|text|0|evaluate an arithmetic expression
pw|text|1|generate a password
uuid|text|0|print a UUID
clip|text|0|copy stdin or arguments to the clipboard
ip|net|1|show the public or private IP
get|net|1|fetch a URL to stdout
post|net|0|POST data to a URL
dl|net|1|download a URL to a file
dns|net|0|show resolvers or resolve a name
port|proc|1|list, filter, test or kill listening ports
pid|proc|1|show a process and its parents
proc|proc|1|list processes by CPU or memory, or kill one
screen|proc|1|start, list, attach or kill screen sessions
q|dev|1|manage and run quick shell commands
clone|dev|1|clone a GitHub repository
g|dev|1|small git helpers (log, status, checkout, reset)
dk|dev|1|thin docker helper
dc|dev|1|docker compose helper
svc|dev|1|list and control system services
open|dev|1|open a path or URL with the desktop
edit|dev|0|edit a file with $EDITOR
log|dev|0|append a timestamped line with rotation
_ED|debug|0|debug log line (always prints)
_RC|debug|0|exit with a code, optionally logging a message
_path|debug|0|print the directory of this u
_file|debug|0|print the absolute path of this u
_selftest|debug|0|run internal assertions
_catalog|debug|0|print the raw command catalog
EOF
}

u_help() {
  local want=${1:-}
  if [ -n "$want" ]; then
    u_usage "$want"
    return 0
  fi
  printf '%s %s - one small cross-platform CLI\n' "$U_NAME" "$U_VERSION"
  printf 'usage: u [--debug] [--json] [--yes] <command> [args...]\n'
  printf '       u help <command>\n'
  printf '       u commands [--all]\n'
  printf '\n'
  local last="" name group heavy summary tag
  u_catalog | while IFS='|' read -r name group heavy summary; do
    case "$name" in
      _*) [ "${U_HELP_ALL:-0}" = 1 ] || continue ;;
    esac
    if [ "$group" != "$last" ]; then
      printf '\n%s\n' "$group"
      last=$group
    fi
    tag=" "
    [ "$heavy" = 1 ] && tag="*"
    printf '  %s %-13s %s\n' "$tag" "$name" "$summary"
  done
  printf '\n* daily command. Debug helpers are hidden; use: u help --all\n'
}

#heavy
u_cmd_help() {
  case "${1:-}" in
    --all|-a)
      U_HELP_ALL=1
      u_help
      ;;
    *)
      u_help "${1:-}"
      ;;
  esac
}

u_usage() {
  local cmd=$1 meta name group heavy summary
  meta=$(u_catalog | awk -F'|' -v n="$cmd" '$1 == n { print; exit }')
  [ -n "$meta" ] || u_die 2 "unknown command: $cmd (see: u help)"
  name=$(printf '%s\n' "$meta" | cut -d'|' -f1)
  group=$(printf '%s\n' "$meta" | cut -d'|' -f2)
  heavy=$(printf '%s\n' "$meta" | cut -d'|' -f3)
  summary=$(printf '%s\n' "$meta" | cut -d'|' -f4)
  printf '%s [%s]%s\n%s\n\n' "$name" "$group" "$([ "$heavy" = 1 ] && printf ' (daily)')" "$summary"
  printf 'usage:\n'
  case "$cmd" in
    help)
      printf '%s\n' \
        '  u help' \
        '  u help <command>' \
        '  u help --all'
      ;;
    version)
      printf '%s\n' '  u version' '  u --json version'
      ;;
    commands)
      printf '%s\n' '  u commands [--all]' '  u --json commands [--all]'
      ;;
    setup)
      printf '%s\n' '  u setup [--no-rc]'
      ;;
    self-update)
      printf '%s\n' '  u self-update'
      ;;
    doctor)
      printf '%s\n' '  u doctor [--strict]' '  u --json doctor'
      ;;
    os)
      printf '%s\n' \
        '  u os                    print "<os> <arch>"' \
        '  u os info               print OS details' \
        '  u os pkg                print the package manager' \
        '  u os arch               print the CPU architecture' \
        '  u os is <trait>         exit 0 when the trait matches'
      ;;
    has)
      printf '%s\n' \
        '  u has cmd <name...>' \
        '  u has file|dir|path <path...>' \
        '  u has env <NAME...>'
      ;;
    env)
      printf '%s\n' '  u env' '  u env NAME [default]'
      ;;
    np)
      printf '%s\n' '  u np <command> [args...]'
      ;;
    pkg)
      printf '%s\n' \
        '  u pkg                         print the package manager' \
        '  u pkg update                  refresh package indexes' \
        '  u pkg upgrade [name...]       upgrade all, or named packages' \
        '  u pkg install [--slim] <name...>' \
        '  u pkg remove <name...>' \
        '  u pkg search <name>' \
        '  u pkg clean'
      ;;
    trash)
      printf '%s\n' \
        '  u trash <path...>             move paths to trash' \
        '  u trash ls                    list trash entries' \
        '  u trash undo <id...>          restore an entry' \
        '  u trash rm <id...>            delete an entry permanently' \
        '  u trash clean [days] [--yes]  delete entries older than days (90)' \
        '  u trash empty --yes           delete every entry'
      ;;
    stat)
      printf '%s\n' '  u stat [--json] [--bytes] [--epoch] <path>'
      ;;
    find)
      printf '%s\n' \
        '  u find <pattern> [base]' \
        '  u find --name <pattern> [base]' \
        '  u find --base DIR [--context N] [--depth N] [--hidden] <pattern>'
      ;;
    recent)
      printf '%s\n' '  u recent [minutes] [count] [--base DIR]'
      ;;
    zip)
      printf '%s\n' \
        '  u zip [--out FILE] <path...>' \
        '  u zip ls <file>' \
        '  u zip unzip <file> [--dest DIR]'
      ;;
    str)
      printf '%s\n' \
        '  u str eq <a> <b>' \
        '  u str contains <text> <needle>' \
        '  u str replace <text> <search> <replacement>' \
        '  u str num <text>' \
        '  u str upper|lower|trim <text>' \
        '  u str len <text>'
      ;;
    date)
      printf '%s\n' \
        '  u date                       ISO 8601 now' \
        '  u date fmt [format]          now in a strftime format' \
        '  u date epoch <time>          seconds since epoch' \
        '  u date show <epoch> [format]' \
        '  u date age <a> [b]           seconds from a to b (b defaults to now)' \
        '  u date older <a> <b> [gap]   exit 0 when a is older than b by gap'
      ;;
    b64)
      printf '%s\n' '  u b64 [text]' '  u b64 --decode [text]' '  printf %s text | u b64 [--decode]'
      ;;
    calc)
      printf '%s\n' '  u calc "<expression>"'
      ;;
    pw)
      printf '%s\n' '  u pw [length] [--symbols]'
      ;;
    uuid)
      printf '%s\n' '  u uuid'
      ;;
    clip)
      printf '%s\n' '  u clip [text]' '  printf %s text | u clip'
      ;;
    ip)
      printf '%s\n' \
        '  u ip                 public IPv4' \
        '  u ip local           private IP' \
        '  u ip --6             public IPv6' \
        '  u ip all             public IPv4 and IPv6, one per line'
      ;;
    get)
      printf '%s\n' '  u get [--head] [-o FILE] [-4|-6] <url>'
      ;;
    post)
      printf '%s\n' \
        '  u post <url> [data]' \
        '  u post --file FILE <url>' \
        '  u post --form|--text <url> [data]'
      ;;
    dl)
      printf '%s\n' '  u dl [-o FILE] [--github] [-4|-6] <url>'
      ;;
    dns)
      printf '%s\n' '  u dns' '  u dns <domain>'
      ;;
    port)
      printf '%s\n' \
        '  u port                      list listening TCP ports' \
        '  u port <number|name>        filter the list' \
        '  u port free <number>        exit 0 when the port is free' \
        '  u port kill <number> [--yes]'
      ;;
    pid)
      printf '%s\n' '  u pid <pid|name>'
      ;;
    proc)
      printf '%s\n' \
        '  u proc                 top 15 processes by CPU' \
        '  u proc --mem           top 15 by memory' \
        '  u proc <name>          filter processes' \
        '  u proc kill <name|pid> [--yes]'
      ;;
    screen)
      printf '%s\n' \
        '  u screen                    attach, or start when none exists' \
        '  u screen ls' \
        '  u screen new [name]' \
        '  u screen attach <name>' \
        '  u screen detach' \
        '  u screen kill [name] [--yes]'
      ;;
    q)
      printf '%s\n' \
        '  u q                       list quick commands' \
        '  u q <name> [args...]      run one' \
        '  u q run <name> [args...]' \
        '  u q add <name> [command...]' \
        '  u q cat|edit|path <name>' \
        '  u q rm <name>'
      ;;
    clone)
      printf '%s\n' '  u clone [--ssh] [--dir DIR] <owner/repo|url>'
      ;;
    g)
      printf '%s\n' \
        '  u g [log [n]]' \
        '  u g st' \
        '  u g co <ref>' \
        '  u g reset <ref> [--yes]' \
        '  u g branches'
      ;;
    dk)
      printf '%s\n' \
        '  u dk [ps]' \
        '  u dk images|stats|inspect <name>|clean' \
        '  u dk logs <name> [-f]' \
        '  u dk sh <name>' \
        '  u dk run <image> [command...]' \
        '  u dk stop|rm <name>' \
        '  u dk save <name> [file]' \
        '  u dk load <file>'
      ;;
    dc)
      printf '%s\n' \
        '  u dc up|down|ps|stop|images' \
        '  u dc logs [service] [-f]' \
        '  u dc sh [service]' \
        '  u dc exec <service> <command...>' \
        '  u dc build [--no-cache]' \
        '  u dc restart [service]'
      ;;
    svc)
      printf '%s\n' \
        '  u svc                     list services' \
        '  u svc status <name>' \
        '  u svc start|stop|restart|enable|disable <name>'
      ;;
    open)
      printf '%s\n' '  u open <path|url>' '  u open --app <name>   (macOS only)'
      ;;
    edit)
      printf '%s\n' '  u edit [file]'
      ;;
    log)
      printf '%s\n' '  u log [--lines N] <file> <message...>'
      ;;
    _ED)
      printf '%s\n' '  u _ED <message...>        always prints to stderr'
      ;;
    _RC)
      printf '%s\n' '  u _RC <code> [message...]'
      ;;
    _path)
      printf '%s\n' '  u _path'
      ;;
    _file)
      printf '%s\n' '  u _file'
      ;;
    _selftest)
      printf '%s\n' '  u _selftest'
      ;;
    _catalog)
      printf '%s\n' '  u _catalog'
      ;;
    *)
      printf '  u %s [args...]\n' "$cmd"
      ;;
  esac
  printf '\nexit codes: 0 ok, 1 failure or predicate false, 2 usage, 3 missing dependency, 4 environment, 5 conflict\n'
  printf 'examples:\n'
  case "$cmd" in
    trash) printf '%s\n' '  u trash ./old-report' '  u trash ls' '  u trash undo 1764050000-1234' ;;
    find) printf '%s\n' '  u find "TODO" .' '  u find --name "*.md" ~/Documents' '  u find --context 2 "fixme" src' ;;
    date) printf '%s\n' '  u date' '  u date epoch "2026-11-25 12:00:00"' '  u date older "2020-01-01" "2021-01-01"' ;;
    q) printf '%s\n' '  u q add deploy "cd ~/app && git pull && make"' '  u q deploy' ;;
    ip) printf '%s\n' '  u ip' '  u ip local' ;;
    port) printf '%s\n' '  u port 8080' '  u port free 8080' ;;
    *) printf '  u %s\n' "$cmd" ;;
  esac
}

u_cmd_commands() {
  local all=0
  [ "${1:-}" = "--all" ] && all=1
  local name group heavy summary flag
  if [ "$U_JSON" = 1 ]; then
    printf '['
    local first=1
    u_catalog | while IFS='|' read -r name group heavy summary; do
      case "$name" in
        _*) [ "$all" = 1 ] || continue ;;
      esac
      [ "$first" = 1 ] || printf ','
      first=0
      flag=false
      [ "$heavy" = 1 ] && flag=true
      printf '{"name":%s,"group":%s,"heavy":%s,"summary":%s}' \
        "$(u_json_str "$name")" "$(u_json_str "$group")" "$flag" "$(u_json_str "$summary")"
    done
    printf ']\n'
  else
    u_catalog | while IFS='|' read -r name group heavy summary; do
      case "$name" in
        _*) [ "$all" = 1 ] || continue ;;
      esac
      printf '%s\t%s\t%s\t%s\n' "$name" "$group" "$heavy" "$summary"
    done
  fi
}

# --- core commands ---------------------------------------------------------
u_cmd_version() {
  if [ "$U_JSON" = 1 ]; then
    printf '{"name":%s,"version":%s}\n' "$(u_json_str "$U_NAME")" "$(u_json_str "$U_VERSION")"
  else
    printf '%s\n' "$U_VERSION"
  fi
}

u_self_path() {
  local src="${BASH_SOURCE[0]}" dir
  if [ -z "$src" ]; then
    printf '%s\n' "$0"
    return 0
  fi
  while [ -L "$src" ]; do
    dir=$(cd -P "$(dirname "$src")" >/dev/null 2>&1 && pwd)
    src=$(readlink "$src")
    case "$src" in
      /*) ;;
      *) src="$dir/$src" ;;
    esac
  done
  case "$src" in
    /*) ;;
    *) src="$(pwd)/$src" ;;
  esac
  printf '%s/%s\n' "$(cd -P "$(dirname "$src")" 2>/dev/null && pwd)" "$(basename "$src")"
}

u_rc_file() {
  case "$(u_shell_name)" in
    zsh) printf '%s\n' "$HOME/.zshrc" ;;
    bash)
      if [ "$U_OS" = mac ]; then
        printf '%s\n' "$HOME/.bash_profile"
      else
        printf '%s\n' "$HOME/.bashrc"
      fi
      ;;
    *)
      if [ -f "$HOME/.zshrc" ]; then
        printf '%s\n' "$HOME/.zshrc"
      else
        printf '%s\n' "$HOME/.bashrc"
      fi
      ;;
  esac
}

#heavy
u_cmd_setup() {
  local no_rc=0
  case "${1:-}" in
    --no-rc) no_rc=1 ;;
    "") ;;
    *) u_die 2 "usage: u setup [--no-rc]" ;;
  esac
  u_ensure_dirs

  local self target
  self=$(u_self_path)
  target="$U_BIN/u"
  if [ "$self" != "$target" ] && ! [ "$self" -ef "$target" ]; then
    cp -f "$self" "$target" || u_die 4 "cannot install u into $U_BIN"
    chmod 755 "$target"
  fi

  if [ "$no_rc" = 0 ]; then
    local rc block
    rc=$(u_rc_file)
    block='# >>> u >>>'
    if [ -f "$rc" ] && grep -qF "$block" "$rc" 2>/dev/null; then
      u_log "PATH block already present in $rc"
    else
      {
        printf '\n%s\n' "$block"
        printf 'export PATH="%s:$PATH"\n' "$U_BIN"
        printf '%s\n' '# <<< u <<<'
      } >>"$rc" || u_die 4 "cannot write $rc"
      printf 'added %s to %s\n' "$U_BIN" "$rc"
    fi
  fi

  printf 'u %s installed at %s\n' "$U_VERSION" "$target"
  case ":$PATH:" in
    *":$U_BIN:"*) ;;
    *) printf 'run: export PATH="%s:$PATH"\n' "$U_BIN" ;;
  esac
  printf 'then: u help\n'
}

u_download_to() {
  local url=$1 out=$2
  if u_has_cmd curl; then
    curl -fsSL --retry 1 --max-time 30 -o "$out" "$url"
  elif u_has_cmd wget; then
    wget -q -O "$out" "$url"
  else
    u_die 3 "curl or wget is required"
  fi
}

u_update_urls() {
  [ -n "${U_UPDATE_URL:-}" ] && printf '%s\n' "$U_UPDATE_URL"
  printf '%s\n' "$U_RAW"
  local prefix
  for prefix in \
    "https://fastgit.cc/" \
    "http://gh.ddlc.top/" \
    "http://ghfast.top/" \
    "https://ghproxy.monkeyray.net/" \
    "https://cdn.akaere.online/"
  do
    printf '%s%s\n' "$prefix" "$U_RAW"
  done
}

u_cmd_self_update() {
  u_ensure_dirs
  local tmp="$U_DIR/.u.new.$$"
  local url ok=0
  while IFS= read -r url; do
    [ -n "$url" ] || continue
    u_log "trying $url"
    if u_download_to "$url" "$tmp" 2>/dev/null && [ -s "$tmp" ]; then
      if head -n 1 "$tmp" | grep -q '^#!/usr/bin/env bash' &&
        grep -q '^U_VERSION=' "$tmp" &&
        bash -n "$tmp" 2>/dev/null; then
        ok=1
        break
      fi
    fi
  done <<EOF
$(u_update_urls)
EOF
  if [ "$ok" = 0 ]; then
    rm -f "$tmp"
    u_die 1 "could not download a valid u from any mirror"
  fi

  local newver
  newver=$(bash "$tmp" version 2>/dev/null || true)
  [ -n "$newver" ] || { rm -f "$tmp"; u_die 1 "downloaded u did not report a version"; }
  if [ "$newver" = "$U_VERSION" ]; then
    rm -f "$tmp"
    printf 'already at %s\n' "$U_VERSION"
    return 0
  fi

  mkdir -p "$U_BIN"
  cp -f "$tmp" "$U_BIN/u.new" || { rm -f "$tmp"; u_die 4 "cannot write $U_BIN"; }
  chmod 755 "$U_BIN/u.new"
  mv -f "$U_BIN/u.new" "$U_BIN/u"
  rm -f "$tmp"
  printf 'updated %s -> %s (%s/u)\n' "$U_VERSION" "$newver" "$U_BIN"
}

#heavy
u_cmd_doctor() {
  local strict=0
  case "${1:-}" in
    "") ;;
    --strict) strict=1 ;;
    *) u_die 2 "usage: u doctor [--strict]" ;;
  esac
  local home_pct root_pct load cores dep found missing=0
  local warnings=""
  home_pct=$(u_disk_pct "$HOME")
  root_pct=$(u_disk_pct /)
  load=$(u_load1)
  cores=$(u_cores)

  if [ -n "$home_pct" ] && [ "$home_pct" -ge 90 ]; then
    warnings="${warnings}home disk ${home_pct}%>=90%;"
  fi
  if [ -n "$root_pct" ] && [ "$root_pct" -ge 90 ]; then
    warnings="${warnings}root disk ${root_pct}%>=90%;"
  fi
  if [ -n "$load" ] && [ -n "$cores" ] && awk -v l="$load" -v c="$cores" 'BEGIN { exit !(l > c * 2) }'; then
    warnings="${warnings}load ${load}>2x cores ${cores};"
  fi

  if [ "$U_JSON" = 1 ]; then
    printf '{"name":%s,"version":%s,"os":%s,"arch":%s,"shell":%s,"state":%s,"deps":{' \
      "$(u_json_str "$U_NAME")" "$(u_json_str "$U_VERSION")" "$(u_json_str "$U_OS")" \
      "$(u_json_str "$U_ARCH")" "$(u_json_str "$(u_shell_name)")" "$(u_json_str "$U_DIR")"
    local first=1
    for dep in curl wget git python3 jq rg ag screen docker zip 7z lsof ss netstat; do
      found=false
      u_has_cmd "$dep" && found=true
      [ "$first" = 1 ] || printf ','
      first=0
      printf '"%s":%s' "$dep" "$found"
    done
    printf '},"disk":{"root_pct":%s,"home_pct":%s},"load":{"one":%s,"cores":%s},"warnings":[' \
      "${root_pct:-0}" "${home_pct:-0}" "${load:-0}" "${cores:-0}"
    if [ -n "$warnings" ]; then
      local old_ifs=$IFS
      IFS=';'
      local w
      first=1
      for w in $warnings; do
        [ -n "$w" ] || continue
        [ "$first" = 1 ] || printf ','
        first=0
        printf '%s' "$(u_json_str "$w")"
      done
      IFS=$old_ifs
    fi
    printf ']}\n'
  else
    printf '%s %s on %s %s (%s)\n' "$U_NAME" "$U_VERSION" "$U_OS" "$U_ARCH" "$(u_shell_name)"
    printf 'state   %s\n' "$U_DIR"
    printf 'deps\n'
    for dep in curl wget git python3 jq rg ag screen docker zip 7z lsof ss netstat; do
      if u_has_cmd "$dep"; then
        printf '  [ok] %s\n' "$dep"
      else
        printf '  [--] %s\n' "$dep"
        missing=$((missing + 1))
      fi
    done
    printf 'disk    / %s%%  %s %s%%\n' "${root_pct:-?}" "$HOME" "${home_pct:-?}"
    printf 'load    %s (%s cores)\n' "${load:-?}" "${cores:-?}"
    if [ -n "$warnings" ]; then
      printf 'warnings\n'
      local old_ifs=$IFS
      IFS=';'
      local w
      for w in $warnings; do
        [ -n "$w" ] && printf '  %s\n' "$w"
      done
      IFS=$old_ifs
    fi
    printf 'missing optional tools: %s\n' "$missing"
  fi

  if [ "$strict" = 1 ]; then
    for dep in curl git; do
      u_has_cmd "$dep" || return 1
    done
  fi
  return 0
}

